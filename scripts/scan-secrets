#!/usr/bin/env python3
"""Scan reachable local history, the index, and current tracked/unignored files."""
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile


def git(*args):
    return subprocess.check_output(["git", *args], stderr=subprocess.DEVNULL)


def check():
    os.umask(0o077)
    scanner = shutil.which("gitleaks")
    if not scanner:
        raise ValueError
    version = subprocess.check_output([scanner, "version"], stderr=subprocess.DEVNULL)
    if not re.fullmatch(rb"v?\d+\.\d+\.\d+\s*", version):
        raise ValueError
    if tuple(map(int, version.strip().lstrip(b"v").split(b"."))) < (8, 30, 0):
        raise ValueError
    os.chdir(os.fsdecode(git("rev-parse", "--show-toplevel").rstrip(b"\n")))
    if git("rev-parse", "--is-shallow-repository").strip() != b"false":
        raise ValueError

    with tempfile.TemporaryDirectory(prefix="vemi-scan-") as temporary:
        root = Path(temporary)
        (root / "rules.toml").write_text("[extend]\nuseDefault = true\n")
        (root / "empty.ignore").touch()
        files = root / "files"
        files.mkdir()
        for raw in set(git("ls-files", "-z", "--cached", "--others", "--exclude-standard").split(b"\0")):
            if not raw:
                continue
            name = Path(os.fsdecode(raw))
            if name.is_absolute() or any(part == ".." for part in name.parts):
                raise ValueError
            if any(parent.is_symlink() for parent in name.parents):
                raise ValueError
            try:
                mode = name.lstat().st_mode
            except FileNotFoundError:
                continue
            dest = files / name
            dest.parent.mkdir(parents=True, exist_ok=True)
            if stat.S_ISLNK(mode):
                dest.write_bytes(os.fsencode(os.readlink(name)))
            elif stat.S_ISREG(mode):
                shutil.copyfile(name, dest)
            else:
                raise ValueError

        for mode, args in (
            ("git", ["--log-opts=--all --reflog --full-history -m"]),
            ("git", ["--staged"]),
            ("dir", [str(files)]),
        ):
            command = [scanner, mode, "--redact=100", "--no-banner", "--ignore-gitleaks-allow",
                       "--config", str(root / "rules.toml"), "--gitleaks-ignore-path",
                       str(root / "empty.ignore"), "--max-archive-depth=1", "--timeout=180"]
            subprocess.run(command + args, check=True, timeout=190,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    try:
        check()
    except (OSError, ValueError, subprocess.SubprocessError):
        print("Secret scan blocked. Check gitleaks >=8.30.0, full Git history, and findings locally.",
              file=sys.stderr)
        sys.exit(1)
    print("Secret scan passed for local refs/reflogs, index, and tracked/unignored files.")
